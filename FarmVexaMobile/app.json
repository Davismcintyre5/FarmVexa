{
  "expo": {
    "name": "FarmVexa",
    "slug": "farmvexamobile",
    "version": "1.0.1",
    "scheme": "farmvexa",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2d6a4f"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.farmvexa.mobile",
      "buildNumber": "2",
      "associatedDomains": ["applinks:farmvexa.pxxl.click"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2d6a4f"
      },
      "package": "com.farmvexa.mobile",
      "versionCode": 2,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "farmvexa" },
            { "scheme": "https", "host": "farmvexa.pxxl.click", "pathPrefix": "/invoice" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "FarmVexa"
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker",
      "expo-location",
      "expo-notifications",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "87eeb813-daba-46d8-a1ba-382b1b55b9ed"
      }
    }
  }
}