{
  "name": "farmvexa-desktop",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "FarmVexa Farmer Dashboard - AI-Powered Farm Intelligence Desktop Application",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "generate-icons": "node scripts/generate-icons.js",
    "electron:dev": "concurrently \"vite --port 3000\" \"wait-on http://localhost:3000 && C:\\Electron\\electron.exe .\"",
    "electron:build": "npm run generate-icons && vite build && electron-builder --publish always",
    "electron:build:win": "npm run generate-icons && vite build && electron-builder --win --publish always",
    "electron:build:mac": "npm run generate-icons && vite build && electron-builder --mac --publish always",
    "electron:build:linux": "npm run generate-icons && vite build && electron-builder --linux --publish always",
    "electron:build:local": "npm run generate-icons && vite build && electron-builder --publish never",
    "electron:start": "C:\\Electron\\electron.exe .",
    "release:patch": "npm version patch -m 'Release v%s'",
    "release:minor": "npm version minor -m 'Release v%s'",
    "release:major": "npm version major -m 'Release v%s'",
    "release:push": "git push --follow-tags"
  },
  "author": {
    "name": "Davis Okoth",
    "email": "davismcintyre5@gmail.com"
  },
  "publisher": "HDM",
  "owner": "Davis Okoth",
  "company": "HDM",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.0",
    "electron-updater": "^6.2.1",
    "lucide-react": "^0.400.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hot-toast": "^2.4.0",
    "react-router-dom": "^6.26.0",
    "socket.io-client": "^4.7.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.2",
    "electron": "^43.4.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.4.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.0",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.hdm.farmvexa",
    "productName": "FarmVexa",
    "copyright": "Copyright © 2024 HDM - Davis Okoth",
    "publish": {
      "provider": "github",
      "owner": "Davismcintyre5",
      "repo": "FarmVexa",
      "releaseType": "release",
      "publishAutoUpdate": true
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "publisherName": "HDM"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "FarmVexa-Setup-${version}.exe"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Office"
    }
  }
}